# Django core
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Database — use DATABASE_URL, or the discrete DB_* vars below
DATABASE_URL=
DB_ENGINE=django.db.backends.postgresql
DB_NAME=my_accountant_db
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Redis (Channels layer + presence)
REDIS_URL=redis://127.0.0.1:6379/1

# JWT lifetimes
ACCESS_TOKEN_LIFETIME_MINUTES=150
REFRESH_TOKEN_LIFETIME_DAYS=30
ROTATE_REFRESH_TOKENS=True
BLACKLIST_AFTER_ROTATION=True

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Social login
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_SECRET=
OAUTH_FACEBOOK_CLIENT_ID=
OAUTH_FACEBOOK_SECRET=

# Email (Brevo / Anymail) — console backend used when DEBUG=True
BREVO_API_KEY=
DEFAULT_FROM_EMAIL=My Accountant <noreply@myaccountant.com>
SERVER_EMAIL=support@myaccountant.com
